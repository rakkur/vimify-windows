; Dynamic Include Generator for hotKeys.ahk
; This script reads the ahk/apps directory and generates include statements

#SingleInstance Force
SetWorkingDir %A_ScriptDir%

; Path to the apps directory
appsDir := A_ScriptDir . "\apps"
outputFile := A_ScriptDir . "\dynamic_includes.ahk"

; Clear the output file
FileDelete, %outputFile%

; Add header comment
FileAppend, ; *** {{{ Dynamic includes - Auto-generated from ahk/apps directory`n, %outputFile%
FileAppend, ; Generated on: %A_Now%`n, %outputFile%
FileAppend, ;`n, %outputFile%
FileAppend, ; This file is automatically generated by reading the ahk/apps directory`n, %outputFile%
FileAppend, ; To regenerate: Run the generate_includes.ahk script`n, %outputFile%
FileAppend, ;`n, %outputFile%

; Get all .ahk files from the apps directory and sort them alphabetically
fileList := ""
Loop, %appsDir%\*.ahk
{
    fileName := A_LoopFileName
    ; Skip the generator script itself if it's in the apps directory
    if (fileName = "generate_includes.ahk")
        continue
    
    fileList .= fileName . "`n"
}

; Sort the file list alphabetically
Sort, fileList

; Create the include statements
Loop, Parse, fileList, `n
{
    if (A_LoopField != "")
    {
        includeLine := "#Include %A_ScriptDir%\ahk\apps\" . A_LoopField . "`n"
        FileAppend, %includeLine%, %outputFile%
    }
}

FileAppend, `n; }}}`n, %outputFile%

MsgBox, Dynamic includes generated successfully!`n`nOutput file: %outputFile%`n`nFiles included: %A_Index%`n`nThe hotKeys.ahk script will now automatically include all .ahk files from the apps directory.
